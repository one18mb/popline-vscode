{
  "name": "popline-vscode",
  "displayName": "PopLine",
  "description": "PopLine language support for VS Code",
  "version": "0.1.0",
  "publisher": "one18mb",
  "repository": { "type": "git", "url": "https://github.com/one18mb/popline-vscode.git" },
  "engines": { "vscode": "^1.70.0" },
  "categories": ["Programming Languages", "Formatters"],
  "contributes": {
    "languages": [{
      "id": "popline",
      "aliases": ["PopLine", "popline"],
      "extensions": [".pln"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "popline",
      "scopeName": "source.popline",
      "path": "./syntaxes/pln.tmLanguage.json"
    }],
    "semanticTokenColorCustomizations": {
      "enabled": true,
      "rules": {
        "comment.popline": { "foreground": "#6A9955", "fontStyle": "italic" },
        "keyword.popline": { "foreground": "#569CD6" },
        "string.popline": { "foreground": "#CE9178" },
        "number.popline": { "foreground": "#B5CEA8" },
        "property.popline": { "foreground": "#9CDCFE" },
        "punctuation.popline": { "foreground": "#D4D4D4" }
      }
    }
  },
  "icon": "icon.png",
  "activationEvents": [],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": { "supported": true },
    "virtualWorkspaces": true
  }
}
